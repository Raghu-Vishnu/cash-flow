# Copy this file to ".env" and fill in your values. ".env" is never committed.
# Google OAuth "Web application" client ID, used for Google Drive backup (see README.md).
# Leave empty to turn Google Drive backup off.
GOOGLE_CLIENT_ID=

# Anonymous usage counts (optional): your GoatCounter site code, e.g. "cashflow" for https://cashflow.goatcounter.com
GOATCOUNTER_CODE=

# Who sees the Insights page (optional): comma-separated Gmail addresses. Only SHA-256 fingerprints are published.
ADMIN_EMAILS=
